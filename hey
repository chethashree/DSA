<script>
function submitSelectedChecks() {
    const checks = [];
    const rows = document.querySelectorAll('#checkTable tbody tr');

    rows.forEach(row => {
        const name = row.querySelector('.check-name').value.trim();
        const howToPerform = row.querySelector('.how-to-perform').value.trim();
        const expectedOutcome = row.querySelector('.expected-outcome').value.trim();

        if (name && howToPerform && expectedOutcome) {
            checks.push({ name, how_to_perform: howToPerform, expected_outcome: expectedOutcome });
        }
    });

    const mailTemplate = {
        subject: document.getElementById('mailSubject').value.trim(),
        recipients: document.getElementById('mailRecipients').value.trim(),
        body: document.getElementById('mailBody').value.trim()
    };

    fetch('/submit_checks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ checks, mail_template: mailTemplate })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Selected checks and mail template saved successfully!');
        } else {
            alert('Failed to save data.');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while saving.');
    });
}

</script>





