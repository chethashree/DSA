@app.route('/view_saved_table')
def view_saved_table():
    if 'account_name' not in session:
        return redirect(url_for('index'))

    account_name = session['account_name']
    application_name, _, _ = get_account_details(account_name)
    folder = get_application_folder(application_name)

    latest_file = None
    latest_time = None

    for root_dir, _, files in os.walk(folder):
        for f in files:
            if f.startswith("check_verified_table") and f.endswith(".xml"):
                path = os.path.join(root_dir, f)
                file_time = os.path.getmtime(path)
                if latest_time is None or file_time > latest_time:
                    latest_time = file_time
                    latest_file = path

    if not latest_file:
        return f"<h3>No saved data found for application {application_name}</h3>"

    # Load check_verified_table XML
    tree = ET.parse(latest_file)
    root = tree.getroot()

    rows = []
    for row_elem in root.findall("Row"):
        row_data = [col.text or "" for col in row_elem]
        rows.append(row_data)

    # Load mail template from selected_checks.xml
    selected_path = os.path.join(folder, 'selected_checks.xml')
    subject = recipients = body = ""
    if os.path.exists(selected_path):
        selected_tree = ET.parse(selected_path)
        selected_root = selected_tree.getroot()
        mail_elem = selected_root.find("mail_template")
        if mail_elem is not None:
            subject = mail_elem.findtext("subject", "")
            recipients = mail_elem.findtext("recipients", "")
            body = mail_elem.findtext("body", "")

    return render_template("view_saved_table.html", account_name=account_name, rows=rows,
                           subject=subject, recipients=recipients, body=body)


def get_account_details(account_name):
    initialize_xml()
    try:
        tree = ET.parse(XML_FILE)
        root = tree.getroot()
    except ET.ParseError:
        return None, None, None

    for entry in root.findall("entry"):
        if entry.find("account_name").text == account_name:
            return (
                entry.find("application_name").text,
                entry.find("service_now_name").text,
                entry.find("timestamp").text,
            )
    return None, None, None

