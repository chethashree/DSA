@app.route('/save_table', methods=['POST'])
def save_table():
    table_data_json = request.form.get('table_data')
    if not table_data_json:
        return "No data received", 400

    table_data = json.loads(table_data_json)
    account_name = session.get('account_name')
    application_name, _, _ = get_account_details(account_name)

    folder = get_application_folder(application_name)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filepath = os.path.join(folder, f'check_verified_table_{timestamp}.xml')

    root = ET.Element("CheckVerifiedTable")
    session_elem = ET.SubElement(root, "SessionDetails")
    ET.SubElement(session_elem, "AccountName").text = account_name
    ET.SubElement(session_elem, "Timestamp").text = timestamp

    for row in table_data:
        if all(row[:4]) and row[5]:
            row_elem = ET.SubElement(root, "Row")
            for i, cell in enumerate(row):
                ET.SubElement(row_elem, f"Col{i+1}").text = cell

    tree = ET.ElementTree(root)
    tree.write(filepath, encoding="utf-8", xml_declaration=True)

    # Call extract_images_to_xml functionality
    screenshots_dir = os.path.join("static", "screenshots")
    evidence_dir = os.path.join(folder, "evidence")
    os.makedirs(evidence_dir, exist_ok=True)

    evidence_xml = ET.Element("Evidence")
    for row in root.findall("Row"):
        image_url = row.find("Col5").text or ""
        if image_url:
            image_name = os.path.basename(image_url)
            source_path = os.path.join(screenshots_dir, image_name)
            target_path = os.path.join(evidence_dir, image_name)
            if os.path.exists(source_path):
                shutil.copyfile(source_path, target_path)
                ET.SubElement(evidence_xml, "Image").text = f"evidence/{image_name}"

    evidence_tree = ET.ElementTree(evidence_xml)
    evidence_tree.write(os.path.join(folder, "evidence_log.xml"), encoding="utf-8", xml_declaration=True)

    return "Data and evidence saved successfully"


