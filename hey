<!DOCTYPE html>
<html>

<head>
    <title>Saved Checks for {{ account_name }}</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f4f9f4;
            padding: 20px;
        }

        h2 {
            color: #2c3e50;
        }

        table {
            border-collapse: collapse;
            width: 100%;
            margin-top: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            background-color: white;
        }

        th,
        td {
            border: 1px solid #ccc;
            padding: 10px;
            vertical-align: top;
            text-align: left;
        }

        th {
            background-color: #2ecc71;
            color: white;
        }

        img.evidence-preview {
            max-width: 550px;
            max-height: 500px;
            display: block;
            margin: 10px auto;
            object-fit: contain;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

        .narrow-id {
            width: 80px;
        }

        .narrow-name {
            width: 120px;
        }

        .narrow-how {
            width: 180px;
        }

        .narrow-outcome {
            width: 150px;
        }

        .narrow-passfail {
            width: 80px;
            text-align: center;
        }

        .narrow-notes {
            width: 160px;
        }
        .badge {
    padding: 6px 12px;
    border-radius: 20px;
    font-weight: bold;
    font-size: 0.9em;
    display: inline-block;
    text-align: center;
}

.badge-pass {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
}

.badge-fail {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
}

.badge-empty {
    background-color: #e2e3e5;
    color: #6c757d;
    border: 1px solid #d6d8db;
}

    </style>
</head>

<body>

    <h2>Saved Checks for {{ account_name }}</h2>
    <div style="margin-bottom: 30px; padding: 20px; background-color: #fff; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
    <h3 style="color: #2ecc71;">📧 Outlook Mail Template</h3>
    <p><strong>Subject:  </strong> {{ subject }}</p>
    <p><strong>Recipients:  </strong> {{ recipients }}</p>
    <p><strong>Body:  </strong>{{ body }}</p>
    <!-- <div style="white-space: pre-line; border: 1px solid #ddd; padding: 10px; background-color: #f9f9f9; border-radius: 6px;"> -->
        
    <!-- </div> -->
</div>

    <table>
        <thead>
            <tr>
                <th class="narrow-id">Check ID</th>
                <th class="narrow-name">Check Name</th>
                <th class="narrow-how">How to Perform</th>
                <th class="narrow-outcome">Expected Outcome</th>
                <th>Evidence</th>
                <th class="narrow-passfail">Pass/Fail</th>
                <th class="narrow-notes">Additional Notes</th>
            </tr>
        </thead>
    <tbody>
{% for row in rows %}
<tr>
    {% for col in row %}
        {% if col and ('data:image' in col or col.endswith('.png') or col.endswith('.jpg') or col.endswith('.jpeg') or col.endswith('.webp')) %}
            <td><img src="{{ col }}" alt="Evidence" class="evidence-preview"></td>
        {% elif loop.index == 6 %}
            <td>
                {% if col.strip().lower() == "pass" %}
                    <span class="badge badge-pass">✓ PASS</span>
                {% elif col.strip().lower() == "fail" %}
                    <span class="badge badge-fail">✗ FAIL</span>
                {% else %}
                    <span class="badge badge-empty">--</span>
                {% endif %}
            </td>
        {% else %}
            <td>{{ col }}</td>
        {% endif %}
    {% endfor %}
</tr>
{% endfor %}
</tbody>


    </table>

</body>

</html>

