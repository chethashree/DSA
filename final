<script>
function saveTable() {
    const tableRows = document.querySelectorAll("#checksTable tbody tr");
    const tableData = [];

    tableRows.forEach(row => {
        const cells = row.cells;

        // Extract each column's content correctly
        const check_id = cells[0]?.innerText.trim();
        const check_name = cells[1]?.innerText.trim();
        const how_to = cells[2]?.innerText.trim();
        const expected = cells[3]?.innerText.trim();
        
        // For image
        const evidence_img = cells[4].querySelector('img');
        const evidence = evidence_img && evidence_img.src ? evidence_img.src : '';

        // For Pass/Fail (radio input - if implemented)
        let pass_fail = '';
        const radioInputs = cells[5].querySelectorAll('input[type=radio]');
        radioInputs.forEach(input => {
            if (input.checked) pass_fail = input.value;
        });

        // Fallback for contenteditable
        if (!pass_fail) pass_fail = cells[5]?.innerText.trim();

        const notes = cells[6]?.innerText.trim();

        tableData.push([check_id, check_name, how_to, expected, evidence, pass_fail, notes]);
    });

    // Send to backend
    const formData = new URLSearchParams();
    formData.append("table_data", JSON.stringify(tableData));

    fetch("/save_table", {
        method: "POST",
        headers: {
            "Content-Type": "application/x-www-form-urlencoded"
        },
        body: formData
    })
    .then(res => res.text())
    .then(data => alert(data))
    .catch(err => alert("Error saving data: " + err));
}
</script>

