<script>
    function submitSelectedChecks() {
        const checks = [];
        const rows = document.querySelectorAll('#checkTable tbody tr');

        rows.forEach(row => {
            const name = row.querySelector('.check-name').value.trim();
            const howToPerform = row.querySelector('.how-to-perform').value.trim();
            const expectedOutcome = row.querySelector('.expected-outcome').value.trim();

            if (name && howToPerform && expectedOutcome) {
                checks.push({ name, how_to_perform: howToPerform, expected_outcome: expectedOutcome });
            }
        });

        if (checks.length > 0) {
            fetch('/submit_checks', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ checks })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Selected checks saved successfully!');
                } else {
                    alert('Failed to save selected checks.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while saving the selected checks.');
            });
        } else {
            alert('Please fill out at least one row before submitting.');
        }
    }
</script>





