from flask import Flask, render_template, request, redirect, url_for, jsonify, session
import os
import xml.etree.ElementTree as ET
from datetime import datetime
import subprocess


app = Flask(__name__)
app.secret_key = "user_session_id"   # Needed for session

XML_FILE = 'data/data.xml'
SELECTED_CHECKS_FILE = 'data/selected_checks.xml'


# Ensure XML file and structure exist
def initialize_xml():
    if not os.path.exists(XML_FILE):
        os.makedirs(os.path.dirname(XML_FILE), exist_ok=True)
        root = ET.Element("root")
        tree = ET.ElementTree(root)
        tree.write(XML_FILE)

def initialize_selected_checks_xml():
    if not os.path.exists(SELECTED_CHECKS_FILE):
        os.makedirs(os.path.dirname(SELECTED_CHECKS_FILE), exist_ok=True)
        root = ET.Element("selected_checks")
        tree = ET.ElementTree(root)
        tree.write(SELECTED_CHECKS_FILE)

@app.route('/submit_checks', methods=['POST'])
def submit_checks():
    initialize_selected_checks_xml()

    # Get the username from the session
    user_name = session.get('account_name')

    # If user is not logged in, reject the request
    if not user_name:
        return jsonify({'success': False, 'message': 'User not logged in'}), 400

    checks_data = request.json.get('checks', [])

    # Parse the XML file
    tree = ET.parse(SELECTED_CHECKS_FILE)
    root = tree.getroot()

    # Find the user element or create it if it does not exist
    user_elem = root.find(f"./user[@name='{user_name}']")
    if user_elem is None:
        user_elem = ET.Element('user', attrib={'name': user_name})
        root.append(user_elem)

    # Existing checks
    existing_check_names = {check.find('name').text for check in user_elem.findall('check')}

    # Iterate over the new checks data
    for check in checks_data:
        check_name = check.get('name', '')

        # If the check is already present, skip it
        if check_name in existing_check_names:
            print(f"Check '{check_name}' already exists. Skipping...")
            continue

        # Create new check element
        check_elem = ET.Element('check')

        name_elem = ET.SubElement(check_elem, 'name')
        name_elem.text = check_name

        how_elem = ET.SubElement(check_elem, 'how_to_perform')
        how_elem.text = check.get('how_to_perform', '')

        expected_elem = ET.SubElement(check_elem, 'expected_outcome')
        expected_elem.text = check.get('expected_outcome', '')

        # Append the new check to the user's checks
        user_elem.append(check_elem)

    # Write the updated XML back to the file
    tree.write(SELECTED_CHECKS_FILE, encoding='utf-8', xml_declaration=True)

    return jsonify({'success': True, 'message': 'Checks updated successfully'})


def get_account_details(account_name):
    initialize_xml()
    try:
        tree = ET.parse(XML_FILE)
