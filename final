    function loadScreenshots() {
        fetch("/get_screenshots")
        .then(response => response.json())
        .then(files => {
            const container = document.getElementById("screenshotsList");
            container.innerHTML = "";
            if (files.length === 0) {
                container.innerHTML = "<p>No screenshots available.</p>";
            } else {
                files.forEach(file => {
                    const img = document.createElement("img");
                    img.src = `/static/screenshots/${file}`;
                    img.classList.add("screenshot-img");
                    img.draggable = true;
                    img.addEventListener("dragstart", (e) => {
                        e.dataTransfer.setData("text/plain", img.src);
                    });
                    container.appendChild(img);
                });
            }
        })
        .catch(err => console.error("Error loading screenshots:", err));
    }
        
        
