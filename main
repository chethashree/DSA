  <h3>Table Preview</h3>
  <!-- Selected table appears here -->
</div>

<script>
  document.querySelector('form').addEventListener('submit', function (e) {
    e.preventDefault();

    const appName = document.getElementById('appName').value;
    const date = document.getElementById('searchDate').value;

    fetch(`/search_tables?application_name=${appName}&date=${date}`)
      .then(res => res.json())
      .then(data => {
        const fileList = document.getElementById("fileListContainer");
        fileList.innerHTML = "<h3>Saved Tables</h3>";

        const tableDisplay = document.getElementById("tableDisplayContainer");
        tableDisplay.innerHTML = "<h3>Table Preview</h3>";

        if (data.files.length === 0) {
          fileList.innerHTML += "<p>No tables found for the selected date.</p>";
          return;
        }

        data.files.forEach(file => {
          const div = document.createElement("div");
          div.className = "result-item";
          div.innerHTML = `
            <strong>${file}</strong>
            <button class="view-button" onclick="viewTable('${file}', '${appName}')">View</button>
          `;
          fileList.appendChild(div);
        });
      });
  });

  function viewTable(filename, appName) {
    fetch(`/view_table_content?application_name=${appName}&filename=${filename}`)
      .then(res => res.text())
      .then(html => {
        const display = document.getElementById("tableDisplayContainer");
        display.innerHTML = `<h3>Table Preview</h3>${html}`;
      });
  }
</script>

</body>
