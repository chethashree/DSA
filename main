from flask import Flask, render_template, request, jsonify, send_from_directory
import os
import xml.etree.ElementTree as ET
from datetime import datetime

app = Flask(__name__)

# Utility: Get path to application's folder
def get_application_folder(application_name):
    folder_path = os.path.join("data", application_name)
    os.makedirs(folder_path, exist_ok=True)
    return folder_path

@app.route("/")
def main_dashboard():
    return render_template("main.html")

@app.route("/search_tables")
def search_tables():
    application_name = request.args.get('application_name')
    date = request.args.get('date')  # format: YYYY-MM-DD

    if not application_name or not date:
        return jsonify({'files': []})

    folder = get_application_folder(application_name)
    matched_files = []

    # Format to YYYYMMDD to match filenames
    date_token = date.replace("-", "")

    for file in os.listdir(folder):
        if file.startswith("check_verified_table") and file.endswith(".xml") and date_token in file:
            matched_files.append(file)

    return jsonify({'files': matched_files})

@app.route("/view_table_content")
def view_table_content():
    application_name = request.args.get('application_name')
    filename = request.args.get('filename')

    if not application_name or not filename:
        return "<p>Missing application or file name.</p>"

    folder = get_application_folder(application_name)
    file_path = os.path.join(folder, filename)

    if not os.path.exists(file_path):
        return "<p>File not found.</p>"

    try:
        tree = ET.parse(file_path)
        root = tree.getroot()
    except ET.ParseError:
        return "<p>Invalid XML file.</p>"

    rows = []
    for row_elem in root.findall("Row"):
        row_data = [col.text or "" for col in row_elem]
        rows.append(row_data)

    html = "<table border='1' cellpadding='8' style='margin-top:10px; border-collapse:collapse;'>"
    for row in rows:
        html += "<tr>" + "".join(f"<td>{cell}</td>" for cell in row) + "</tr>"
    html += "</table>"

    return html

if __name__ == "__main__":
    app.run(debug=True)


