import xml.etree.ElementTree as ET
import base64
import os
import win32com.client as win32

# Load and parse XML
tree = ET.parse('data.xml')
root = tree.getroot()

# Define column headers
column_headers = ['Col1', 'Col2', 'Col3', 'Col4 (Image)', 'Col5', 'Col6', 'Col7']

# Start building HTML table
html_table = "<table border='1' cellpadding='5' cellspacing='0'><thead><tr>"
for header in column_headers:
    html_table += f"<th>{header}</th>"
html_table += "</tr></thead><tbody>"

# Loop through each Row in CheckVerifiedTable
for row in root.findall('Row'):
    html_table += "<tr>"
    for i in range(1, 8):  # Col1 to Col7
        col_tag = f"Col{i}"
        value = row.find(col_tag).text if row.find(col_tag) is not None else ''

        # Col4 contains image path
        if i == 4:
            img_path = value
            if os.path.exists(img_path):
                with open(img_path, 'rb') as img_file:
                    img_b64 = base64.b64encode(img_file.read()).decode()
                    value = f"<img src='data:image/jpeg;base64,{img_b64}' width='100' />"
            else:
                value = 'Image not found'

        html_table += f"<td>{value}</td>"
    html_table += "</tr>"

html_table += "</tbody></table>"

# Send via Outlook
outlook = win32.Dispatch('outlook.application')
mail = outlook.CreateItem(0)
mail.Subject = 'XML Report - CheckVerifiedTable'
mail.HTMLBody = f"<h3>CheckVerifiedTable Report</h3>{html_table}"
mail.To = 'recipient@example.com'  # Replace with actual recipient
mail.Display()  # Use mail.Send() to send directly






