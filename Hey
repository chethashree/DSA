from bs4 import BeautifulSoup
import os
import base64
import win32com.client as win32

# Load HTML
with open('view_saved_table.html', 'r', encoding='utf-8') as f:
    soup = BeautifulSoup(f.read(), 'html.parser')

# Convert image sources to base64 so Outlook displays them inline
for img in soup.find_all('img'):
    img_path = img['src']
    if os.path.exists(img_path):
        with open(img_path, 'rb') as image_file:
            encoded_string = base64.b64encode(image_file.read()).decode()
            img['src'] = f'data:image/jpeg;base64,{encoded_string}'

# Final HTML table string
table_html = str(soup.find('table'))

# Send email with Outlook
outlook = win32.Dispatch('outlook.application')
mail = outlook.CreateItem(0)
mail.Subject = 'Automated Check Table Report'
mail.HTMLBody = f"<h2>Check Summary</h2>{table_html}"
mail.To = 'recipient@example.com'  # Replace with actual recipient
mail.Display()  # Use mail.Send() to send directly
