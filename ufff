@app.route("/get_dashboard_content")
def get_dashboard_content():
    import re
    BASE_DIR = "data"
    FILENAME_PATTERN = re.compile(r"check_verified_table_(\d+)\.xml")
    data = {}

    for app_name in sorted(os.listdir(BASE_DIR)):
        app_path = os.path.join(BASE_DIR, app_name)
        if not os.path.isdir(app_path):
            continue

        for date_folder in os.listdir(app_path):
            date_path = os.path.join(app_path, date_folder)
            if not os.path.isdir(date_path):
                continue

            files = [f for f in os.listdir(date_path) if FILENAME_PATTERN.match(f)]
            if not files:
                continue

            latest_file = max(files, key=lambda x: int(FILENAME_PATTERN.search(x).group(1)))
            data.setdefault(date_folder, {})[app_name] = {
                "file": latest_file,
                "path": f"/view_file?app={app_name}&date={date_folder}&file={latest_file}"
            }

    sorted_data = dict(sorted(data.items(), reverse=True))
    return jsonify(sorted_data)

