<script>
    window.onload = function () {
        loadDashboard();  // Show dashboard first
    };

    function loadDashboard() {
        fetch('/get_dashboard_content')
            .then(res => res.json())
            .then(data => {
                const container = document.getElementById("dashboardContent");
                container.innerHTML = "<h3 style='color:#2ecc71'>Latest XML Checks by Date</h3>";

                for (const date in data) {
                    container.innerHTML += `<h4>${date}</h4><ul>`;
                    for (const app in data[date]) {
                        const info = data[date][app];
                        container.innerHTML += `<li><strong>${app}</strong> — ${info.file} <a href="${info.path}" target="_blank">View</a></li>`;
                    }
                    container.innerHTML += "</ul>";
                }

                // Hide login/register by default
                document.getElementById("register").style.display = "none";
                document.getElementById("login").style.display = "none";
                document.getElementById("sidebar").style.display = "none";
            });
    }

    function showForm(id) {
        // Hide dashboard
        document.getElementById("dashboardContent").style.display = "none";

        // Show only selected form
        document.getElementById("register").style.display = id === 'register' ? 'block' : 'none';
        document.getElementById("login").style.display = id === 'login' ? 'block' : 'none';
    }
</script>


