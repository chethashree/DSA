@app.route("/get_user_check_definitions", methods=["GET"])
def get_user_check_definitions():
    if 'account_name' not in session:
        return jsonify([])

    account_name = session['account_name']
    filepath = f"data/xml_definitions_{account_name}.xml"

    if not os.path.exists(filepath):
        return jsonify([])

    try:
        tree = ET.parse(filepath)
        root = tree.getroot()
    except ET.ParseError:
        return jsonify([])

    checks = []
    for check in root.findall("Check"):
        checks.append({
            "check_id": check.findtext("CheckID", ""),
            "check_name": check.findtext("CheckName", ""),
            "how_to_perform": check.findtext("HowToPerform", ""),
            "expected_output": check.findtext("ExpectedOutput", "")
        })

    return jsonify(checks)



@app.route("/save_check_definitions", methods=["POST"])
def save_check_definitions():
    if 'account_name' not in session:
        return "Unauthorized", 401

    account_name = session['account_name']
    data = request.get_json()
    checks = data.get("checks")

    if not checks or not isinstance(checks, list):
        return "Invalid data", 400

    filepath = f"data/xml_definitions_{account_name}.xml"
    os.makedirs(os.path.dirname(filepath), exist_ok=True)

    # Handle corrupted or empty XML files
    root = None
    if os.path.exists(filepath):
        try:
            tree = ET.parse(filepath)
            root = tree.getroot()
        except ET.ParseError:
            root = ET.Element("CheckDefinitions")
            tree = ET.ElementTree(root)
    else:
        root = ET.Element("CheckDefinitions")
        tree = ET.ElementTree(root)

    for check in checks:
        check_id = check.get("check_id")
        check_name = check.get("check_name")
        how_to_perform = check.get("how_to_perform")
        expected_output = check.get("expected_output")

        if not all([check_id, check_name, how_to_perform, expected_output]):
            continue  # skip incomplete rows

        check_elem = ET.SubElement(root, "Check")
        ET.SubElement(check_elem, "CheckID").text = check_id
        ET.SubElement(check_elem, "CheckName").text = check_name
        ET.SubElement(check_elem, "HowToPerform").text = how_to_perform
        ET.SubElement(check_elem, "ExpectedOutput").text = expected_output

    tree.write(filepath, encoding="utf-8", xml_declaration=True)
    return "Check definitions saved successfully"



@app.route("/save_verified_table", methods=["POST"])
def save_verified_table():
    if 'account_name' not in session:
        return "Unauthorized", 401

    account_name = session['account_name']
    data = request.get_json()
    rows = data.get("rows", [])

    if not rows:
        return "No data to save", 400

    root = ET.Element("CheckVerifiedTable")
    ET.SubElement(root, "AccountName").text = account_name

    for row in rows:
        row_elem = ET.SubElement(root, "Row")
        ET.SubElement(row_elem, "CheckID").text = row.get("check_id", "")
        ET.SubElement(row_elem, "CheckName").text = row.get("check_name", "")
        ET.SubElement(row_elem, "HowToPerform").text = row.get("how_to_perform", "")
        ET.SubElement(row_elem, "ExpectedOutput").text = row.get("expected_output", "")
        ET.SubElement(row_elem, "Evidence").text = row.get("evidence", "")
        ET.SubElement(row_elem, "PassFail").text = row.get("pass_fail", "")
        ET.SubElement(row_elem, "Notes").text = row.get("notes", "")

    os.makedirs("saved_tables", exist_ok=True)
    filepath = f"saved_tables/check_verified_table_{account_name}.xml"
    ET.ElementTree(root).write(filepath, encoding="utf-8", xml_declaration=True)

    return "Verification table saved successfully!"


