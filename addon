    const sidebar = document.getElementById("screenshotSidebar");

    let isDragging = false;
    let offsetX, offsetY;

    sidebar.addEventListener("mousedown", function(e) {
        isDragging = true;
        offsetX = e.clientX - sidebar.offsetLeft;
        offsetY = e.clientY - sidebar.offsetTop;
        sidebar.style.cursor = "grabbing";
    });

    document.addEventListener("mouseup", function() {
        isDragging = false;
        sidebar.style.cursor = "move";
    });

    document.addEventListener("mousemove", function(e) {
        if (isDragging) {
            sidebar.style.left = (e.clientX - offsetX) + "px";
            sidebar.style.top = (e.clientY - offsetY) + "px";
        }
    });


            function addRow() {
    const tbody = document.querySelector("#checkTable tbody");
    const row = document.createElement("tr");
    row.innerHTML = `
        <td><input type="text" name="check_id" required></td>
        <td><input type="text" name="check_name" required></td>
        <td><input type="text" name="how_to_perform" required></td>
        <td><input type="text" name="expected_output" required></td>
    `;
    tbody.appendChild(row);
}

function submitCheckDefinitions() {
    const rows = document.querySelectorAll("#checkTable tbody tr");
    const checks = [];

    rows.forEach(row => {
        const check_id = row.querySelector("input[name='check_id']").value;
        const check_name = row.querySelector("input[name='check_name']").value;
        const how_to_perform = row.querySelector("input[name='how_to_perform']").value;
        const expected_output = row.querySelector("input[name='expected_output']").value;

        if (check_id && check_name && how_to_perform && expected_output) {
            checks.push({ check_id, check_name, how_to_perform, expected_output });
        }
    });

    if (checks.length === 0) {
        alert("Please fill out at least one complete row.");
        return;
    }

    fetch('/save_check_definitions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ checks })
    })
    .then(res => res.text())
    .then(msg => {
        alert(msg);
        document.querySelector("#checkTable tbody").innerHTML = '';
        addRow(); // reset with one empty row
    })
    .catch(err => alert("Error saving data: " + err));
}

            function loadPreviewTable() {
    fetch('/get_user_check_definitions')
        .then(response => response.json())
        .then(data => {
            const tbody = document.querySelector("#previewTable tbody");
            tbody.innerHTML = "";

            data.forEach((check, index) => {
                tbody.innerHTML += `
                    <tr>
                        <td>${check.check_id}</td>
                        <td>${check.check_name}</td>
                        <td>${check.how_to_perform}</td>
                        <td>${check.expected_output}</td>
                        <td 
                            class="evidence-cell" 
                            ondragover="event.preventDefault();" 
                            ondrop="handleEvidenceDrop(event, ${index})"
                        >
                            <div class="drop-area">Drop Image Here</div>
                            <img id="evidencePreview${index}" style="display:none; width: 200px; border-radius: 8px; margin-top: 5px;" />
                        </td>
                        <td>
                            <label><input type="radio" name="pass_fail_${index}" value="Pass"> Pass</label>
                            <label><input type="radio" name="pass_fail_${index}" value="Fail"> Fail</label>
                        </td>
                        <td contenteditable="true"></td>
                    </tr>
                `;
            });
        });
}
function handleEvidenceDrop(event, index) {
    event.preventDefault();

    const files = event.dataTransfer.files;
    if (files.length === 0) return;

    const file = files[0];
    if (!file.type.startsWith("image/")) {
        alert("Only image files allowed");
        return;
    }

    const reader = new FileReader();
    reader.onload = function (e) {
        const img = document.getElementById(`evidencePreview${index}`);
        img.src = e.target.result;
        img.style.display = "block";

        const dropArea = img.previousElementSibling;
        if (dropArea && dropArea.classList.contains("drop-area")) {
            dropArea.style.display = "none";
        }
    };
    reader.readAsDataURL(file);
}


function saveVerifiedTable() {
    const table = document.querySelector("#previewTable");
    const rows = Array.from(table.querySelectorAll("tbody tr")).map((row, i) => {
        const cells = row.querySelectorAll("td");
        const passFail = row.querySelector(`input[name='pass_fail_${i}']:checked`);
        const img = cells[4].querySelector("img");

        return {
            check_id: cells[0].innerText.trim(),
            check_name: cells[1].innerText.trim(),
            how_to_perform: cells[2].innerText.trim(),
            expected_output: cells[3].innerText.trim(),
            evidence: img && img.src ? img.src : "",
            pass_fail: passFail ? passFail.value : "",
            notes: cells[6].innerText.trim()
        };
    });

    fetch("/save_verified_table", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ rows })
    })
    .then(res => res.text())
    .then(msg => alert(msg))
    .catch(err => alert("Error saving table: " + err));
}



            
            
            


            function activateScreenshot() {
        fetch("/activate_screenshot", {
            method: "POST"
        })
        .then(response => response.json())
        .then(data => {
            alert(data.message);
            if (data.status === "success") {
                document.getElementById("screenshotSidebar").style.display = "block";
                loadScreenshots();  // Load screenshots immediately upon activation
                setInterval(loadScreenshots, 10000); // Refresh every 10 seconds
            }
        })
        .catch(err => console.error("Error:", err));
    }

    function loadScreenshots() {
        fetch("/get_screenshots")
        .then(response => response.json())
        .then(files => {
            const container = document.getElementById("screenshotsList");
            container.innerHTML = "";
            if (files.length === 0) {
                container.innerHTML = "<p>No screenshots available.</p>";
            } else {
                files.forEach(file => {
                    const img = document.createElement("img");
                    img.src = `/static/screenshots/${file}`;
                    img.classList.add("screenshot-img");
                    img.draggable = true;
                    img.addEventListener("dragstart", (e) => {
                        e.dataTransfer.setData("text/plain", img.src);
                    });
                    container.appendChild(img);
                });
            }
        })
        .catch(err => console.error("Error loading screenshots:", err));
    }
        
        </script>
