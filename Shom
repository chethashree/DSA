import os
import re
import xml.etree.ElementTree as ET
from flask import Flask, render_template, request, send_from_directory

app = Flask(__name__)

# Configuration
BASE_DIR = "xml_data"  # Adjust to your actual XML directory
FILENAME_PATTERN = re.compile(r"check_(\d+)\.xml")

def get_status_from_xml(filepath):
    try:
        tree = ET.parse(filepath)
        status = tree.getroot().findtext("status")
        return status if status else "Error"
    except Exception as e:
        print(f"Error parsing {filepath}: {e}")
        return "Error"

@app.route("/")
def dashboard():
    data = {}
    for app_name in sorted(os.listdir(BASE_DIR)):
        app_path = os.path.join(BASE_DIR, app_name)
        if not os.path.isdir(app_path):
            continue

        for date_folder in os.listdir(app_path):
            date_path = os.path.join(app_path, date_folder)
            if not os.path.isdir(date_path):
                continue

            files = [f for f in os.listdir(date_path) if FILENAME_PATTERN.match(f)]
            if not files:
                continue

            latest_file = max(files, key=lambda x: int(FILENAME_PATTERN.search(x).group(1)))
            status = get_status_from_xml(os.path.join(date_path, latest_file))

            # Format date_folder to YYYY-MM-DD for matching <input type="date">
            try:
                # assume date_folder is in that format already
                formatted_date = date_folder
            except ValueError:
                formatted_date = date_folder

            data.setdefault(formatted_date, {})[app_name] = {
                "file": latest_file,
                "path": f"/view_file?app={app_name}&date={formatted_date}&file={latest_file}",
                "status": status
            }

    sorted_data = dict(sorted(data.items(), reverse=True))
    return render_template("dashboard.html", data=sorted_data)

@app.route("/view_file")
def view_file():
    app_name = request.args.get("app")
    date = request.args.get("date")
    file = request.args.get("file")
    directory = os.path.join(BASE_DIR, app_name, date)
    if not os.path.isfile(os.path.join(directory, file)):
        return "File not found", 404
    return send_from_directory(directory, file)

if __name__ == "__main__":
    app.run(debug=True)


