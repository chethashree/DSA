import paramiko
import time
from datetime import datetime
from pathlib import Path


class SFTPUtility:
    def __init__(
        self,
        host,
        username,
        password=None,
        key_filename=None,
        port=22,
        connect_retries=5,
        retry_delay=5,
        timeout=10,
    ):
        self.host = host
        self.port = port
        self.username = username
        self.password = password
        self.key_filename = key_filename
        self.connect_retries = connect_retries
        self.retry_delay = retry_delay
        self.timeout = timeout

        self.ssh = None
        self.sftp = None

    # ----------------------------
    # Connection Handling
    # ----------------------------
    def connect(self):
        for attempt in range(1, self.connect_retries + 1):
            try:
                self.ssh = paramiko.SSHClient()
                self.ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())

                self.ssh.connect(
                    hostname=self.host,
                    port=self.port,
                    username=self.username,
                    password=self.password,
                    key_filename=self.key_filename,
                    timeout=self.timeout,
                )

                self.sftp = self.ssh.open_sftp()

                print(f"[CONNECTED] SFTP connected to {self.host}")
                return

            except Exception as e:
                print(f"[RETRY {attempt}] Connection failed: {e}")

                if attempt == self.connect_retries:
                    raise

                time.sleep(self.retry_delay)

    def close(self):
        if self.sftp:
            self.sftp.close()

        if self.ssh:
            self.ssh.close()

        print("[CLOSED] Connection closed")

    # ----------------------------
    # Upload File
    # ----------------------------
    def upload_file(self, local_path, remote_path):
        self.sftp.put(local_path, remote_path)
        print(f"[UPLOAD] {local_path} → {remote_path}")

    # ----------------------------
    # Download File
    # ----------------------------
    def download_file(self, remote_path, local_path):
        self.sftp.get(remote_path, local_path)
        print(f"[DOWNLOAD] {remote_path} → {local_path}")

    # ----------------------------
    # List Files with Metadata
    # ----------------------------
    def list_files(self, remote_dir):
        files = self.sftp.listdir_attr(remote_dir)

        file_details = []

        for file in files:
            details = {
                "name": file.filename,
                "path": f"{remote_dir}/{file.filename}",
                "size_bytes": file.st_size,
                "modified_time": datetime.fromtimestamp(file.st_mtime),
            }

            file_details.append(details)

        return file_details

    # ----------------------------
    # Wait Until File Exists
    # ----------------------------
    def wait_for_file(
        self,
        remote_path,
        retries=10,
        delay=10,
    ):
        for attempt in range(1, retries + 1):
            try:
                self.sftp.stat(remote_path)

                print(f"[FOUND] File exists: {remote_path}")
                return True

            except FileNotFoundError:
                print(f"[WAIT] File not found ({attempt}/{retries})")

                if attempt < retries:
                    time.sleep(delay)

        return False

    # ----------------------------
    # Wait Until File Upload Complete
    # ----------------------------
    def wait_until_stable(
        self,
        remote_path,
        checks=3,
        interval=5,
    ):
        previous_size = -1

        stable_count = 0

        while stable_count < checks:
            current_size = self.sftp.stat(remote_path).st_size

            if current_size == previous_size:
                stable_count += 1
            else:
                stable_count = 0

            previous_size = current_size

            time.sleep(interval)

        print(f"[STABLE] File upload complete: {remote_path}")
        return True

    # ----------------------------
    # Download When Ready
    # ----------------------------
    def wait_and_download(
        self,
        remote_path,
        local_path,
        retries=10,
        delay=10,
    ):
        found = self.wait_for_file(remote_path, retries, delay)

        if not found:
            raise FileNotFoundError(f"{remote_path} not found after retries")

        self.wait_until_stable(remote_path)

        self.download_file(remote_path, local_path)



