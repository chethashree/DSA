def get_check_definitions():
    tree = ET.parse(CHECK_DEFINITIONS_FILE)
    root = tree.getroot()
    ns = {'xlink': 'http://www.w3.org/1999/xlink'}

    checks = {}
    for check in root.findall('check'):
        name = check.find('name').text
        how_elem = check.find('how_to_perform')
        description_elem = how_elem.find('description')
        description = description_elem.text if description_elem is not None else ''
        text_elem = how_elem.find('text')
        how_text = text_elem.text if text_elem is not None else ''
        link = text_elem.attrib.get('{http://www.w3.org/1999/xlink}href', '') if text_elem is not None else ''
        outcome = check.find('expected_outcome').text
        checks[name] = {
            'how_to_description': description,
            'how_to_text': how_text,
            'how_to_link': link,
            'expected_outcome': outcome
        }
    return checks

