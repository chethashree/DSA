@app.route("/exportdoc", methods=["POST"])
def exportdoc():
    try:
        from datetime import datetime
        import pythoncom
        pythoncom.CoInitialize()

        account_name = session.get('account_name')
        if not account_name:
            return jsonify({'status': 'error', 'message': 'User session not found'}), 401

        print(f"Export triggered by account: {account_name}")

        # Get application details
        application_name, _, _ = get_account_details(account_name)
        if not application_name:
            return jsonify({'status': 'error', 'message': 'Application not found for user'}), 400

        folder = get_application_folder(application_name)

        # Find the latest XML file in the folder
        latest_file = None
        latest_time = None
        for root_dir, _, files in os.walk(folder):
            for f in files:
                if f.startswith("check_verified_table") and f.endswith(".xml"):
                    path = os.path.join(root_dir, f)
                    file_time = os.path.getmtime(path)
                    if latest_time is None or file_time > latest_time:
                        latest_time = file_time
                        latest_file = path

        if not latest_file:
            return jsonify({'status': 'error', 'message': 'No XML file found for export'}), 404

        # Parse the XML
        tree = ET.parse(latest_file)
        root = tree.getroot()

        column_headers = ['Check ID', 'Check Name', 'How To Perform', 'Expected Outcome, Evidence',
                          'Pass Or Fail', 'Additional Notes', 'Image']
        html_table = "<table border='1' cellpadding='5' cellspacing='0'><thead><tr>"
        for header in column_headers:
            html_table += f"<th>{header}</th>"
        html_table += "</tr></thead><tbody>"

        for row in root.findall('Row'):
            html_table += "<tr>"
            for i in range(1, 8):  # Col1 to Col7
                col_tag = f"Col{i}"
                element = row.find(col_tag)
                value = element.text if element is not None else ''

                if i == 5:  # Col5 is image name or path
                    screenshots_dir = os.path.join("static", "screenshots")
                    image_name = os.path.basename(value)
                    image_path = os.path.join(screenshots_dir, image_name)

                    print(f"Looking for image at: {image_path}")
                    if os.path.exists(image_path):
                        with open(image_path, 'rb') as img_file:
                            img_b64 = base64.b64encode(img_file.read()).decode()
                        value = f"<img src='data:image/png;base64,{img_b64}' width='400'/>"
                    else:
                        value = 'Image not found'
                html_table += f"<td>{value}</td>"
            html_table += "</tr>"
        html_table += "</tbody></table>"

        # Send Outlook email
        try:
            outlook = win32.Dispatch('Outlook.Application')
            mail = outlook.CreateItem(0)
            mail.Subject = f'CheckVerifiedTable Report for {account_name}'
            mail.HTMLBody = f"<h3>CheckVerifiedTable Report for {account_name} / {application_name}</h3>{html_table}"
            mail.Display()
        finally:
            pythoncom.CoUninitialize()

        return jsonify({'status': 'success', 'message': f'Document exported and email triggered for {account_name}.'})

    except Exception as e:
        return jsonify({'status': 'error', 'message': str(e)}), 500
