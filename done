from flask import Flask, render_template, send_file
import os
import xml.etree.ElementTree as ET
from datetime import datetime

app = Flask(__name__)
DATA_DIR = "data"
DATA_XML = os.path.join(DATA_DIR, "data.xml")

def get_application_names():
    if not os.path.exists(DATA_XML):
        return []

    tree = ET.parse(DATA_XML)
    root = tree.getroot()

    app_names = []
    seen = set()

    for entry in root.findall("entry"):
        app_name = entry.findtext("application_name")
        if app_name:
            app_name = app_name.strip()
            if app_name not in seen:
                seen.add(app_name)
                app_names.append(app_name)

    return app_names


def get_latest_xml_file(app_folder_path):
    """Returns latest check_verified_table_*.xml file from the application folder."""
    if not os.path.isdir(app_folder_path):
        return None, None

    xml_files = [
        f for f in os.listdir(app_folder_path)
        if f.startswith("check_verified_table") and f.endswith(".xml")
    ]

    if not xml_files:
        return None, None

    # Sort files by timestamp part in filename (e.g., check_verified_table_20250528_174239.xml)
    xml_files.sort(reverse=True)
    latest_xml = xml_files[0]
    return os.path.join(app_folder_path, latest_xml), latest_xml


def get_status_from_xml(xml_path):
    """
    Reads Col6 of each <Row> in XML.
    Returns 'Pass' if all Col6 values are 'Pass' (case-insensitive),
    else returns 'Fail'.
    """
    try:
        tree = ET.parse(xml_path)
        root = tree.getroot()

        for row in root.findall("Row"):
            col6 = row.findtext("Col6")
            if not col6 or col6.strip().lower() != "pass":
                return "Fail"  # Any non-pass → Fail

        return "Pass"  # All rows were 'pass'
    except Exception as e:
        print(f"XML Parse Error: {e}")
        return "Error"



def get_applications_data():
    applications = []

    app_names = get_application_names()
    for app_name in app_names:
        app_path = os.path.join(DATA_DIR, app_name)
        latest_xml_path, xml_filename = get_latest_xml_file(app_path)

        if not latest_xml_path:
            status = "No Data"
        else:
            status = get_status_from_xml(latest_xml_path)

        applications.append({
            "name": app_name,
            "status": status,
            "file": xml_filename or "",
            "path": latest_xml_path or ""
        })

    return applications

@app.route('/')
def dashboard():
    applications = get_applications_data()
    return render_template("dashboard.html", applications=applications)

@app.route('/preview/<app_name>')
def preview_table(app_name):
    applications = get_applications_data()

    # Get latest file path for this application
    app_path = os.path.join(DATA_DIR, app_name)
    xml_path, _ = get_latest_xml_file(app_path)

    table_headers = [f"Col{i}" for i in range(1, 8)]
    table_rows = []

    if xml_path and os.path.exists(xml_path):
        tree = ET.parse(xml_path)
        root = tree.getroot()

        for row_elem in root.findall("Row"):
            row_data = []
            for col in table_headers:
                val = row_elem.findtext(col)
                row_data.append(val if val else "")
            table_rows.append(row_data)

    return render_template("dashboard.html", applications=applications, table_rows=table_rows, table_headers=table_headers)


if __name__ == '__main__':
    app.run(debug=True)


