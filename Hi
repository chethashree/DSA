from flask import request
import os

@app.route('/save_table', methods=['POST'])
def save_table():
    table_data_json = request.form.get('table_data')
    if not table_data_json:
        return "No data received", 400

    import json
    table_data = json.loads(table_data_json)

    # Save XML
    import xml.etree.ElementTree as ET
    account_name = request.form.get('account_name', 'Anonymous')  # fallback if session not used

    root = ET.Element("CheckVerifiedTable")
    session_elem = ET.SubElement(root, "SessionDetails")
    ET.SubElement(session_elem, "AccountName").text = account_name

    for row in table_data:
        row_elem = ET.SubElement(root, "Row")
        for i, cell in enumerate(row):
            cell_elem = ET.SubElement(row_elem, f"Col{i+1}")
            cell_elem.text = cell

    os.makedirs("saved_tables", exist_ok=True)
    filepath = os.path.join("saved_tables", f"check_verified_table_{account_name}.xml")
    tree = ET.ElementTree(root)
    tree.write(filepath, encoding="utf-8", xml_declaration=True)

    # ===== Save image if exists =====
    image_file = request.files.get('evidence_image')
    if image_file:
        os.makedirs("uploaded_images", exist_ok=True)
        image_path = os.path.join("uploaded_images", f"{account_name}_evidence.png")
        image_file.save(image_path)

    return "Data saved successfully"
